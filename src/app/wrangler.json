{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "logdog-development",
  "main": "src/server.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "Server",
      "image": "../server/Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SERVER",
        "class_name": "Server"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Server"]
    }
  ],
  "env": {
    "production": {
      "name": "logdog",
      "workers_dev": false,
      "preview_urls": false,
      "logpush": true,
      "observability": {
        "logs": {
          "enabled": true
        },
        "traces": {
          "enabled": true
        }
      },
      "routes": [
        {
          "pattern": "logdog.dennise.me",
          "custom_domain": true
        }
      ],
      "containers": [
        {
          "name": "logdog-server",
          "class_name": "Server",
          "image": "../server/Dockerfile",
          "max_instances": 1,
          "instance_type": "basic"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "SERVER",
            "class_name": "Server"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["Server"]
        }
      ]
    }
  }
}
